# Application (T-001)
APP_NAME=Samadhan
APP_ENV=local
APP_DEBUG=true
APP_BASE_URL=http://localhost:8000
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_JSON=false

# Auth (placeholder — change in local .env only)
SECRET_KEY=change-me
SESSION_COOKIE_NAME=samadhan_session

# Infrastructure (T-002)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=samadhan_local

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=samadhan_policies

REDIS_URL=redis://localhost:6379/0

# LLM providers (optional keys — app starts without them)
# LLM_PROVIDER: gemini_api | openai | vertex_ai | fake
LLM_PROVIDER=gemini_api
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
# LLM_FALLBACK_ENABLED=false
# LLM_FALLBACK_PROVIDER=fake
LLM_MAX_PROVIDER_ATTEMPTS=2
LLM_REQUEST_TIMEOUT_SECONDS=30.0
# EMBEDDING_PROVIDER: gemini_api | openai | vertex_ai | fake
EMBEDDING_PROVIDER=gemini_api
# Use fake for local/CI without API keys:
# LLM_PROVIDER=fake
# EMBEDDING_PROVIDER=fake

GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VERTEX_EMBEDDING_MODEL=text-embedding-004
FAKE_EMBEDDING_DIMENSION=768

# RAG retrieval (T-044)
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=10
# RAG_DEFAULT_MIN_SCORE=0.5
RAG_QUERY_MAX_CHARS=2000
QDRANT_REQUEST_TIMEOUT_SECONDS=5.0

# Vertex AI (optional)
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-flash-class-model

# LangSmith (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=samadhan-dev

# Cost controls (enforced in later tasks)
MAX_MESSAGES_PER_USER_PER_DAY=20
MAX_LLM_CALLS_PER_DAY=100
MAX_OUTPUT_TOKENS=800

# Intent classifier (T-053)
INTENT_CLASSIFIER_LLM_FALLBACK_ENABLED=true
INTENT_CLASSIFIER_RULE_ACCEPT_THRESHOLD=0.75
INTENT_CLASSIFIER_MIN_LLM_CONFIDENCE=0.55
INTENT_CLASSIFIER_AMBIGUITY_GAP=0.15

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage
GCS_BUCKET_NAME=
